{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vetrina",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VESTRI_SYNC_OFF=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prototipi",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--bind",
        "127.0.0.1"
      ],
      "port": 4100
    },
    {
      "name": "vetrina-build",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VESTRI_SYNC_OFF=1",
        "npx",
        "next",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000
    }
  ]
}
